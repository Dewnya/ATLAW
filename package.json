{
  "version": "1.0.0",
  "type": "module",
  "source": "./index.html",
  "name": "anima-project",
  "description": "A React project automatically generated by Anima using the Shadcn UI library",
  "scripts": {
    "dev": "vite",
    "build": "vite build && vite build --ssr src/entry-server.tsx --outDir dist-ssr && node scripts/prerender.mjs",
    "import-content": "node scripts/import-content.mjs",
    "build:spa": "vite build"
  },
  "dependencies": {
    "@gsap/react": "^2.1.2",
    "gsap": "^3.15.0",
    "lenis": "^1.3.23",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-helmet-async": "^3.0.0",
    "react-router-dom": "^6.30.0",
    "split-type": "^0.3.4"
  },
  "devDependencies": {
    "@types/react": "18.3.28",
    "@types/react-dom": "18.3.7",
    "@vitejs/plugin-react": "5.1.4",
    "marked": "^16.4.2",
    "sharp": "^0.34.5",
    "tailwindcss": "3.4.16",
    "typescript": "5.9.3",
    "vite": "7.3.1"
  },
  "alias": {
    "@/*": "./src/components/ui/$1"
  }
}
